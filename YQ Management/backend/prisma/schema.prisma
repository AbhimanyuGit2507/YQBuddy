generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TokenStatus {
  WAITING
  SERVING
  COMPLETED
  MISSED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique // e.g., 'hospitalname'
  branding  Json?    // Stores colors, logo URLs
  users     User[]
  queues    Queue[]
  createdAt DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  tenantId String
  email    String @unique
  password String?
  googleId String? @unique
  role     Role   
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model Queue {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  status      QueueStatus 
  nextQueueId String?     // For multi-step routing (e.g. Registration -> Billing)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tokens      Token[]
}

model Token {
  id           String      @id @default(uuid())
  queueId      String
  customerName String
  phone        String
  status       TokenStatus 
  joinedAt     DateTime    @default(now())
  
  // Hybrid Appointments
  isAppointment Boolean    @default(false)
  scheduledFor  DateTime?

  // Feedback & CSAT
  rating       Int?        // 1-5 star rating
  feedbackText String?     // Optional feedback comment

  queue        Queue       @relation(fields: [queueId], references: [id])
}
