generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  OPERATOR
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TokenStatus {
  WAITING
  SERVING
  COMPLETED
  MISSED
}

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  subdomain          String   @unique // e.g., 'hospitalname'
  branding           Json?    // Stores colors, logo URLs
  whatsappInstanceId String?  // Optional Evolution API instance name
  whatsappConnected  Boolean  @default(false)
  whatsappPhone      String?
  chatbotEnabled     Boolean  @default(false)
  chatbotConfig      Json?    // Stores custom button menus and automated replies
  subscriptionStatus String   @default("TRIAL") // TRIAL, ACTIVE, EXPIRED
  users              User[]
  queues             Queue[]
  transactions       Transaction[]
  webhooks           WebhookEndpoint[]
  createdAt          DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  tenantId String
  email    String @unique
  password String?
  googleId String? @unique
  role     Role
  otpCode       String?
  otpExpiresAt  DateTime?
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}

model Queue {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  status      QueueStatus 
  nextQueueId String?     // For multi-step routing (e.g. Registration -> Billing)
  formConfig  Json?       // Dynamic form configuration
  
  // Future Bookings & Hybrid Queuing
  allowAppointments        Boolean @default(false)
  requireManualCheckIn     Boolean @default(false) // If true, customer must click "I have arrived"
  appointmentGranularityMins Int     @default(15)      // e.g. 15 mins increments
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tokens      Token[]

  @@index([tenantId])
}

model Token {
  id           String      @id @default(uuid())
  queueId      String
  customerName String
  phone        String?
  status       TokenStatus 
  joinedAt     DateTime    @default(now())
  
  // Hybrid Appointments
  isAppointment Boolean    @default(false)
  scheduledFor  DateTime?
  checkedIn     Boolean    @default(false)

  // Feedback & CSAT
  rating       Int?        // 1-5 star rating
  feedbackText String?     // Optional feedback comment
  
  formResponses Json?      // Customer answers to dynamic queue fields
  purpose      String?     // Extracted top-level purpose for ETA logic and fast analytics
  language     String      @default("en") // Customer language preference
  
  // Time Tracking (for ETA logic)
  servedAt     DateTime?
  completedAt  DateTime?

  queue        Queue       @relation(fields: [queueId], references: [id])
  messages     Message[]

  @@index([queueId, status])
  @@index([queueId, joinedAt])
}



model Message {
  id        String   @id @default(uuid())
  tokenId   String
  body      String
  sender    String   // 'OPERATOR' or 'CUSTOMER'
  createdAt DateTime @default(now())
  
  token     Token    @relation(fields: [tokenId], references: [id])
  
  @@index([tokenId])
}

model Transaction {
  id              String   @id @default(uuid())
  tenantId        String
  transactionRef  String   @unique
  amount          Float
  currency        String   @default("ZAR")
  status          String   @default("PENDING") // PENDING, COMPLETE, CANCELLED, ERROR
  ozowPayRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  tenantId    String
  url         String
  secret      String?
  events      String[] // Array of event names, e.g. ["TOKEN_COMPLETED", "TOKEN_JOINED"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
