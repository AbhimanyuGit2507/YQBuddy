# QMover Backend - Environment Template
# Copy to .env.dev or .env.production and fill in actual values

# Database - PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
PORT=3000
NODE_ENV=production

# URLs
FRONTEND_URL=https://your-frontend-domain.com
APP_URL=https://your-backend-domain.com
BACKEND_URL=https://your-backend-domain.com

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_here

# Super Admin Email
SUPER_ADMIN_EMAIL=admin@example.com

# Email / Brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=2

# WhatsApp / Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=yq_instance

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payments
OZOW_SITE_CODE=your_site_code
OZOW_PRIVATE_KEY=your_private_key
OZOW_API_KEY=your_api_key

# Test mode - disable in production
TEST_MODE=false